@bot.command()
async def tierratriste(ctx):
    folder = 'images'
    
    if not os.path.exists(folder):
        await ctx.send("¡Ups! No encuentro la carpeta llamada 'images'.")
        return

    # Busca archivos que empiecen con 'tierratriste'
    matching_files = [f for f in os.listdir(folder) if f.lower().startswith('tierratriste')]
    
    if not matching_files:
        await ctx.send("No encontré ninguna imagen de tierratriste en la carpeta.")
        return

    img_name = matching_files[0]
    img_path = os.path.join(folder, img_name)
    
    with open(img_path, 'rb') as f:
        picture = discord.File(f)
        
    await ctx.send(file=picture)
